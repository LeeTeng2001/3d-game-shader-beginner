{
  "name": "shader-fieldnotes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/pages.mjs && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "convert:mill": "node scripts/convert-mill.mjs",
    "build": "npm run typecheck && node scripts/pages.mjs && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:installed": "playwright test --config playwright.installed.config.ts"
  },
  "dependencies": { "three": "0.186.1" },
  "devDependencies": {
    "@types/three": "0.186.0",
    "@playwright/test": "1.58.2",
    "marked": "18.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
